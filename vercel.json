{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com https://github.com; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()"
      },
      "continue": true
    },
    {
      "src": "/fetch(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/results(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/compare(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/jobs(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/import(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/auth(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/share(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/schedules(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/healthz",
      "dest": "/backend/main.py"
    },
    {
      "src": "/clear_cache",
      "dest": "/backend/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}