# Cloud Run production Dockerfile
# Build context: repo root (repo-people-app/)
# Installs repo-people from PyPI (no VCS checkout), so no git in the image.

FROM python:3.11-slim

WORKDIR /app

# Install backend Python dependencies, including repo-people (the data engine),
# all pinned to exact versions in requirements.cloudrun.txt for reproducible builds.
COPY backend/requirements.cloudrun.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
  && python -c "import fastapi, uvicorn, httpx, sse_starlette, aiosqlite"

# Copy backend source
COPY backend/ /app/

# Storage. Set DATABASE_URL to a Postgres connection string for durable,
# multi-instance storage. Without it the app falls back to SQLite at
# REPO_PEOPLE_DB — which on Cloud Run lives in /tmp and is WIPED on every
# cold start, so only use the fallback for throwaway deployments.
ENV REPO_PEOPLE_DB=/tmp/repo_people_jobs.db

# Drop root — nothing here needs to write outside /tmp.
RUN useradd --create-home --uid 10001 appuser
USER appuser

# Cloud Run expects the container to listen on $PORT
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
